# ── LLM 공급사 키 ──────────────────────────────────────────
#
# 로컬 .env 에는 **테스트 전용 키**만 둔다 (LESSONS L-023 '유료 API 호출 예산 규칙' ⑤).
# 운영 키는 Railway·Vercel 환경변수에만 두고 로컬에 내려받지 않는다.
#
# 변수 이름은 운영과 동일하다 — 코드는 키 출처를 구분하지 않는다. 분리는 **키 자체**를
# 다른 워크스페이스/프로젝트에서 발급하는 것으로 한다. 그래야 점검 스크립트가 잘못
# 돌아도 운영 사용량·쿼터·청구서가 섞이지 않는다.
#
#   Anthropic — console 에서 별도 Workspace 생성 후 그 안에서 API key 발급
#               (Workspace 단위로 지출 한도·사용량 조회가 분리된다)
#   Gemini    — Google AI Studio 에서 별도 Google Cloud 프로젝트를 골라 키 발급
#               (프로젝트 단위로 할당량·청구가 분리된다)
#
# 발급 후 아래 두 줄에 테스트 키를 붙여넣는다. 운영 키로 되돌리지 않는다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 서버 ───────────────────────────────────────────────────
# SESSION_SECRET: 프로덕션에서는 필수. 없으면 서버가 기동을 거부한다(server.js, L-013).
#   로컬(배포 감지 없음)에서만 미설정 시 개발용 기본값으로 폴백한다.
SESSION_SECRET=   # 최소 32자 랜덤 문자열 (예: openssl rand -base64 32)
NODE_ENV=development
PORT=3000

# 프로덕션(Railway) 전용 — 런타임-mutable 파일 루트. Volume 마운트 경로 지정 시
# 아바타·제작 캐릭터·models·curation 등이 여기에 저장되고, 부팅 시 프리빌트가
# seed-if-missing으로 복사됨. 로컬 dev에서는 미설정(경로=repo, 동작 무변경).
# RUNTIME_DATA_DIR=/data
# DB_PATH=/data/chat.db
# BACKEND_ORIGIN=http://localhost:3000   # web(next.config·middleware) 프록시 대상

# cutover 후: Express는 API + 정적 자원 전용. 남은 HTML 요청을 넘길 프론트 도메인.
# 미설정 시 리다이렉트 대신 404 JSON (잘못된 도메인으로 보내지 않기 위함).
# FRONTEND_ORIGIN=https://<vercel-프론트-도메인>

# ── Notion 동기화 (scripts/sync-notion.js) ──
# 로컬에서 `npm run sync:notion` 을 돌릴 때만 필요. CI에서는 GitHub Secrets를 쓴다.
# NOTION_TOKEN   Notion 설정 → 개발자 도구 → 연결 에서 만든 API 토큰 (ntn_... 또는 secret_...)
# NOTION_PAGE_ID 동기화 대상 루트 페이지. URL을 그대로 붙여넣어도 된다.
# NOTION_TOKEN=
# NOTION_PAGE_ID=
